{
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 2,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "timeframe": "1h",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "cancel_open_orders_on_exit": true,

  "exchange": {
    "name": "okx",
    "key": "",
    "secret": "",
    "password": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT"
    ],
    "pair_blacklist": []
  },

  "entry_pricing": {
    "price_side": "same",
    "use_order_book": false,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": false,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_exit": "market",
    "force_entry": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },

  "strategy": "FiboStrict",
  "strategy_path": "freqtrade/strategies/",

  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },

  "api_server": {
    "enabled": false,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "fibo_retrace_secret_key",
    "CORS_origins": [],
    "username": "freqtrader",
    "password": "change_this_password"
  },

  "user_data_dir": "freqtrade/user_data",
  "bot_name": "Fibo-Retrace-1H",
  "initial_state": "running",
  "force_entry_enable": false,
  "internalize_positions": false,
  "position_adjustment_enable": false,

  "stoploss": -0.15,
  "trailing_stop": false,
  "minimal_roi": {
    "0": 100.0
  },

  "process_only_new_candles": true,
  "use_exit_signal": true,
  "exit_profit_only": false,
  "ignore_roi_if_entry_signal": false,

  "pairlists": [
    {"method": "StaticPairList"}
  ],

  "verbosity": 1,
  "dataformat_ohlcv": "json",
  "dataformat_trades": "jsongz"
}
